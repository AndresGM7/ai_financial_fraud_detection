# ─── LLM Providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...

# ─── AWS (Bedrock / Lambda / DynamoDB) ───────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
DYNAMODB_TABLE_NAME=fraud_alerts
SNS_ALERT_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:fraud-alerts

# ─── Feature Store ────────────────────────────────────────────────────────────
FEATURE_STORE_PATH=data/processed/feature_store.parquet

# ─── Detection Thresholds ────────────────────────────────────────────────────
ZSCORE_THRESHOLD=3.0
ISOLATION_FOREST_CONTAMINATION=0.02
LLM_RISK_WEIGHT=0.4
ALERT_SCORE_THRESHOLD=0.7
MONITOR_SCORE_THRESHOLD=0.4

# ─── Cost Controls ────────────────────────────────────────────────────────────
LLM_MAX_TOKENS_INPUT=2000
LLM_MAX_TOKENS_OUTPUT=500
LLM_COST_PER_1K_INPUT=0.005
LLM_COST_PER_1K_OUTPUT=0.015
LLM_DAILY_BUDGET_USD=50.0

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ─── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraud_detection

